# Public site origin used for canonical URLs, Open Graph, sitemap, and robots.
# No trailing slash.
VITE_SITE_URL=https://www.siavashakbari.ir

# Supabase Auth and video-only vault-media bucket.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Production's private Vercel Blob connection uses OIDC and injects BLOB_STORE_ID.
# For local maintenance only, put these in ignored .env.local (never add VITE_):
# VAULT_BLOB_STORE_ID=
# VAULT_BLOB_READ_WRITE_TOKEN=

# Optional LOCAL maintenance token. Never prefix this with VITE_ or commit its value.
# SUPABASE_ACCESS_TOKEN=
